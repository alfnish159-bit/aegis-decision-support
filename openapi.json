  "components": {
    "schemas": {
      "ResourceInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "capacity",
          "locationName",
          "maintenance"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Наименование 1…120 символов",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "description": "FIRE, MEDICAL, RESCUE, POLICE, GAS, POWER или VEHICLE",
            "enum": [
              "FIRE",
              "MEDICAL",
              "RESCUE",
              "POLICE",
              "GAS",
              "POWER",
              "VEHICLE"
            ]
          },
          "capacity": {
            "type": "integer",
            "description": "Вместимость 1…100",
            "minimum": 1,
            "maximum": 100
          },
          "locationName": {
            "type": "string",
            "description": "Место базирования 1…120 символов",
            "minLength": 1,
            "maxLength": 120
          },
          "maintenance": {
            "type": "boolean",
            "description": "На обслуживании"
          }
        }
      },
      "Resource": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "capacity",
          "locationName",
          "maintenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "UUID ресурса"
          },
          "name": {
            "type": "string",
            "description": "Наименование 1…120 символов",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "description": "FIRE, MEDICAL, RESCUE, POLICE, GAS, POWER или VEHICLE",
            "enum": [
              "FIRE",
              "MEDICAL",
              "RESCUE",
              "POLICE",
              "GAS",
              "POWER",
              "VEHICLE"
            ]
          },
          "capacity": {
            "type": "integer",
            "description": "Вместимость 1…100",
            "minimum": 1,
            "maximum": 100
          },
          "locationName": {
            "type": "string",
            "description": "Место базирования 1…120 символов",
            "minLength": 1,
            "maxLength": 120
          },
          "maintenance": {
            "type": "boolean",
            "description": "На обслуживании"
          }
        }
      },
      "IncidentInput": {
        "type": "object",
        "required": [
          "typeCode",
          "severityCode",
          "title",
          "description",
          "address",
          "lat",
          "lng",
          "occurredAt",
          "reporterName",
          "phone"
        ],
        "properties": {
          "typeCode": {
            "type": "string",
            "description": "Код incident_type, например FIRE"
          },
          "severityCode": {
            "type": "string",
            "description": "Код severity, например HIGH"
          },
          "title": {
            "type": "string",
            "description": "Заголовок 1…120"
          },
          "description": {
            "type": "string",
            "description": "Описание 10…4000"
          },
          "address": {
            "type": "string",
            "description": "Адрес 1…200"
          },
          "lat": {
            "type": "number",
            "description": "Широта от минус 90 до 90"
          },
          "lng": {
            "type": "number",
            "description": "Долгота от минус 180 до 180"
          },
          "occurredAt": {
            "type": "string",
            "description": "ISO-дата с часовым поясом, не в будущем"
          },
          "reporterName": {
            "type": "string",
            "description": "Имя заявителя 1…120"
          },
          "phone": {
            "type": "string",
            "description": "Телефон 7…30, цифры, пробелы, +, скобки, дефис"
          }
        }
      },
      "Incident": {
        "type": "object",
        "required": [
          "id",
          "number",
          "status_code",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "UUID происшествия"
          },
          "number": {
            "type": "string",
            "description": "Номер bigint сериализуется строкой"
          },
          "status_code": {
            "type": "string",
            "description": "Состояние жизненного цикла"
          },
          "title": {
            "type": "string",
            "description": "Заголовок происшествия"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Машинный код"
          },
          "message": {
            "type": "string",
            "description": "Описание ошибки"
          }
        }
      },
      "StatusInput": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "VERIFICATION",
              "CONFIRMED",
              "RESPONDING",
              "LOCALIZED",
              "RESOLVED"
            ]
          }
        }
      },
      "AssignmentInput": {
        "type": "object",
        "required": [
          "resourceIds"
        ],
        "properties": {
          "resourceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  }
